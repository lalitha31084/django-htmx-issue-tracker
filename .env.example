# ==============================================================================
# Environment variables for the issue tracker.
#
#   cp .env.example .env
#   docker compose up --build -d
#
# Docker Compose reads `.env` automatically. Every value below has a safe
# default inside docker-compose.yml, so the stack also starts without a `.env`
# file - the defaults are development values only.
# ==============================================================================


# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------

# REQUIRED in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#   docker compose run --rm web python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=django-insecure-change-me-to-a-long-random-string

# False in production. When True, Django serves detailed error pages and the
# static files are re-checked on every request.
DEBUG=False

# Comma separated hostnames this instance answers to. "*" accepts any host,
# which is convenient for local evaluation but should be narrowed in production,
# e.g. ALLOWED_HOSTS=tracker.example.com,www.example.com
ALLOWED_HOSTS=*

# Comma separated list of allowed origins for unsafe cross-site requests.
# Needed only when the front-end is served from a different origin than Django.
# CSRF_TRUSTED_ORIGINS=https://tracker.example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=

# Time zone used for date rendering and stored timestamps (IANA name).
TIME_ZONE=UTC

# Python logging level for the application loggers: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Log every enhanced (HX-Request) interaction at INFO level. Genuinely useful
# when demonstrating that HTMX is issuing fragment requests instead of full
# page loads.
LOG_HTMX_REQUESTS=True


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Name of the PostgreSQL database created by the `db` service.
POSTGRES_DB=issue_tracker

# Credentials used by both the `db` service and Django.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Host/port Django uses to reach PostgreSQL *inside the compose network*.
# Leave POSTGRES_HOST=db - it is the compose service name.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Host port the database is published on (useful for `psql` from the host).
POSTGRES_PORT_PUBLISHED=5432

# Seconds a connection is kept alive in the pool. 0 disables persistent
# connections.
POSTGRES_CONN_MAX_AGE=60

# Timeout (seconds) when opening a new database connection.
POSTGRES_CONNECT_TIMEOUT=10

# Name of the throw-away database Django's test runner creates.
POSTGRES_TEST_DB=test_issue_tracker

# Optional: a single connection string (Heroku style). When set and non-empty it
# overrides the individual POSTGRES_* values above, e.g.
# DATABASE_URL=postgresql://postgres:postgres@db:5432/issue_tracker
DATABASE_URL=


# ---------------------------------------------------------------------------
# Web server / ports
# ---------------------------------------------------------------------------

# Host port the application is published on: http://localhost:${WEB_PORT}
WEB_PORT=8000

# Gunicorn worker/thread configuration for the `web` service.
GUNICORN_WORKERS=3
GUNICORN_THREADS=2


# ---------------------------------------------------------------------------
# Convenience for local evaluation only
# ---------------------------------------------------------------------------

# Set to True to have the entrypoint create a Django superuser on startup, so
# /admin/ can be reached immediately.
CREATE_SUPERUSER=False
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123


# ---------------------------------------------------------------------------
# Local development WITHOUT Docker (not used by docker-compose)
# ---------------------------------------------------------------------------

# Use a local SQLite file instead of PostgreSQL. Handy for running the test
# suite without a database server:
#   USE_SQLITE=True python manage.py test tracker
USE_SQLITE=False

# Serve collected static files from the application process.
USE_WHITENOISE=True
SERVE_STATIC=True


# ---------------------------------------------------------------------------
# Production-only hardening (applied by settings.py when DEBUG=False)
# ---------------------------------------------------------------------------

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False